  "narrative": {
    "northStar": "Urban Velocity",
    "overview": "The interface behaves like a useful city tool after dark: immediate route and order decisions, legible status, and one unmistakable action per step. The bright accent marks action and progress; food photography keeps its natural colour. Desktop uses a fixed service rail while mobile shifts to a bottom navigation and a map-first booking sheet.",
    "keyCharacteristics": [
      "Dark tonal surfaces with lime reserved for decisive actions.",
      "Geometric headlines paired with restrained, readable interface copy.",
      "Realistic representative food photography and clearly fictional mobility assets.",
      "Route, price, status, and receipt stay visible at the moment they matter."
    ],
    "rules": [
      {
        "name": "The Action Signal Rule",
        "body": "Reserve lime for selected options, progress and primary actions; do not tint food images or fill every panel with it.",
        "section": "colors"
      },
      {
        "name": "The Scan First Rule",
        "body": "A user should find the next action, current price and current status without reading a paragraph.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do show a clear demo status on fictional bookings and prices.",
      "Do preserve food photos' natural colours and their credited provenance.",
      "Do keep keyboard focus, error text and primary actions visible in both themes."
    ],
    "donts": [
      "Don't imply real dispatch, GPS tracking, merchant fulfilment or payment.",
      "Don't add generic analytics cards to a booking task.",
      "Don't shrink critical mobile labels simply to fit a decorative composition."
    ]
  }
